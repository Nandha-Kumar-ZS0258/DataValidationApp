<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TruStage.Adaptor.Validation</RootNamespace>
    <AssemblyName>TruStage.Adaptor.Validation</AssemblyName>

    <!-- NuGet package identity -->
    <PackageId>TruStage.Adaptor.Validation</PackageId>
    <Version>1.0.0</Version>
    <Authors>TruStage</Authors>
    <Company>TruStage</Company>
    <Description>Data pipeline validation checks, consistency rules, and gate orchestration for the TruStage Credit Union Adaptor platform.</Description>
    <PackageTags>TruStage;Adaptor;Validation;DataPipeline;CreditUnion</PackageTags>
    <Copyright>Copyright © TruStage</Copyright>

    <!-- Produce a .nupkg alongside the DLL on every build -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- Drop the .nupkg to the repo-level packages/ folder so the POC can pick it up -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\packages</PackageOutputPath>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- TruStage.Adaptor.Core is consumed as a pre-built NuGet package, not a project reference -->
    <PackageReference Include="TruStage.Adaptor.Core" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
