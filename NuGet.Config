<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      1. Local user cache – where pre-built TruStage packages are installed.
         Run: dotnet nuget push <pkg>.nupkg -s %USERPROFILE%\.nuget\packages
         Or:  dotnet pack TruStage.Adaptor.Core && dotnet nuget add source ...
    -->
    <add key="local-user-cache" value="%USERPROFILE%\.nuget\packages" />

    <!-- 2. Public NuGet feed for third-party dependencies -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
