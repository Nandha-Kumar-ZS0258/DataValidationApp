<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      1. Local sibling repo packages (Prism.Pipeline.Core, etc.).
         These are pre-packed .nupkg files shipped alongside the Prism repo.
    -->
    <add key="local-packages" value="..\Prism\nuget-packages" />

    <!-- 2. Local user cache for any cached packages -->
    <add key="local-user-cache" value="%USERPROFILE%\.nuget\packages" />

    <!-- 3. Public NuGet feed for third-party dependencies -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-packages">
      <package pattern="Prism.Pipeline.*" />
      <package pattern="Prism.*" />
    </packageSource>
    <packageSource key="local-user-cache">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
